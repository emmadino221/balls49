[Unit]
Description=Email notification for a failed Balls49 backup
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=balls49
EnvironmentFile=/etc/balls49/site.env
EnvironmentFile=/etc/balls49/backup-alert.env
ExecStart=/usr/bin/python3 /home/balls49/balls49/scripts/backup-alert.py
TimeoutStartSec=2min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
